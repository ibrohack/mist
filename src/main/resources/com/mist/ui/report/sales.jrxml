<!-- MIST developer sales report (JasperReports 7). Labels come from the UI bundles through REPORT_RESOURCE_BUNDLE
     ($R{...}); amounts, dates and statuses arrive already formatted in the UI language.
     See docs/ui-design.md, "Sales report (PDF)". -->
<jasperReport name="sales" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="40" bottomMargin="40" whenNoDataType="AllSectionsNoDetail">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="10.0" forecolor="#0A0C0B"/>
	<style name="Caption" fontName="DejaVu Sans" fontSize="9.0" forecolor="#686E69"/>
	<style name="Strong" fontName="DejaVu Sans" fontSize="10.0" bold="true" forecolor="#0A0C0B"/>
	<style name="Stat" fontName="DejaVu Sans" fontSize="16.0" bold="true" forecolor="#0A0C0B"/>
	<style name="Header" mode="Opaque" fontName="DejaVu Sans" fontSize="10.0" bold="true" forecolor="#F2F5EE"
	       backcolor="#151916" vTextAlign="Middle"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="studio" class="java.lang.String"/>
	<parameter name="developer" class="java.lang.String"/>
	<parameter name="generatedAt" class="java.lang.String"/>
	<parameter name="totalRevenue" class="java.lang.String"/>
	<parameter name="totalUnits" class="java.lang.String"/>
	<parameter name="onSale" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="price" class="java.lang.String"/>
	<field name="units" class="java.lang.String"/>
	<field name="revenue" class="java.lang.String"/>
	<field name="rating" class="java.lang.String"/>
	<title height="196">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape">
			<expression><![CDATA[$P{logo}]]></expression>
		</element>
		<element kind="staticText" x="54" y="4" width="200" height="36" fontSize="26.0" bold="true" vTextAlign="Middle">
			<text><![CDATA[MIST]]></text>
		</element>
		<element kind="textField" x="255" y="4" width="260" height="36" fontSize="18.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$R{report.sales.title}]]></expression>
		</element>
		<element kind="line" x="0" y="54" width="515" height="1">
			<pen lineWidth="3.0" lineColor="#C6FF3D"/>
		</element>
		<element kind="textField" x="0" y="70" width="120" height="16" style="Caption">
			<expression><![CDATA[$R{report.studio}]]></expression>
		</element>
		<element kind="textField" x="120" y="70" width="395" height="16" style="Strong">
			<expression><![CDATA[$P{studio}]]></expression>
		</element>
		<element kind="textField" x="0" y="88" width="120" height="16" style="Caption">
			<expression><![CDATA[$R{report.developer}]]></expression>
		</element>
		<element kind="textField" x="120" y="88" width="395" height="16">
			<expression><![CDATA[$P{developer}]]></expression>
		</element>
		<element kind="textField" x="0" y="106" width="120" height="16" style="Caption">
			<expression><![CDATA[$R{report.generated}]]></expression>
		</element>
		<element kind="textField" x="120" y="106" width="395" height="16">
			<expression><![CDATA[$P{generatedAt}]]></expression>
		</element>
		<!-- Summary cards: the same three figures as the dashboard. -->
		<element kind="frame" x="0" y="132" width="165" height="50" mode="Opaque" backcolor="#E4E8E0">
			<element kind="textField" x="10" y="6" width="145" height="14" style="Caption">
				<expression><![CDATA[$R{studio.revenue}]]></expression>
			</element>
			<element kind="textField" x="10" y="22" width="145" height="22" style="Stat">
				<expression><![CDATA[$P{totalRevenue}]]></expression>
			</element>
		</element>
		<element kind="frame" x="175" y="132" width="165" height="50" mode="Opaque" backcolor="#E4E8E0">
			<element kind="textField" x="10" y="6" width="145" height="14" style="Caption">
				<expression><![CDATA[$R{studio.units}]]></expression>
			</element>
			<element kind="textField" x="10" y="22" width="145" height="22" style="Stat">
				<expression><![CDATA[$P{totalUnits}]]></expression>
			</element>
		</element>
		<element kind="frame" x="350" y="132" width="165" height="50" mode="Opaque" backcolor="#E4E8E0">
			<element kind="textField" x="10" y="6" width="145" height="14" style="Caption">
				<expression><![CDATA[$R{studio.published}]]></expression>
			</element>
			<element kind="textField" x="10" y="22" width="145" height="22" style="Stat">
				<expression><![CDATA[$P{onSale}]]></expression>
			</element>
		</element>
	</title>
	<columnHeader height="26">
		<element kind="textField" x="0" y="0" width="150" height="24" style="Header">
			<expression><![CDATA[$R{report.game}]]></expression>
			<box leftPadding="8"/>
		</element>
		<element kind="textField" x="150" y="0" width="85" height="24" style="Header">
			<expression><![CDATA[$R{report.status}]]></expression>
		</element>
		<element kind="textField" x="235" y="0" width="70" height="24" style="Header" hTextAlign="Right">
			<expression><![CDATA[$R{report.price}]]></expression>
		</element>
		<element kind="textField" x="305" y="0" width="60" height="24" style="Header" hTextAlign="Right">
			<expression><![CDATA[$R{report.units}]]></expression>
		</element>
		<element kind="textField" x="365" y="0" width="75" height="24" style="Header" hTextAlign="Right">
			<expression><![CDATA[$R{report.revenue}]]></expression>
		</element>
		<element kind="textField" x="440" y="0" width="75" height="24" style="Header" hTextAlign="Right">
			<expression><![CDATA[$R{report.rating}]]></expression>
			<box rightPadding="8"/>
		</element>
	</columnHeader>
	<detail>
		<band height="22">
			<element kind="textField" x="0" y="0" width="150" height="22" vTextAlign="Middle" textAdjust="ScaleFont">
				<expression><![CDATA[$F{name}]]></expression>
				<box leftPadding="8">
					<bottomPen lineWidth="0.5" lineColor="#C9CEC5"/>
				</box>
			</element>
			<element kind="textField" x="150" y="0" width="85" height="22" vTextAlign="Middle" style="Caption">
				<expression><![CDATA[$F{status}]]></expression>
				<box>
					<bottomPen lineWidth="0.5" lineColor="#C9CEC5"/>
				</box>
			</element>
			<element kind="textField" x="235" y="0" width="70" height="22" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{price}]]></expression>
				<box>
					<bottomPen lineWidth="0.5" lineColor="#C9CEC5"/>
				</box>
			</element>
			<element kind="textField" x="305" y="0" width="60" height="22" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{units}]]></expression>
				<box>
					<bottomPen lineWidth="0.5" lineColor="#C9CEC5"/>
				</box>
			</element>
			<element kind="textField" x="365" y="0" width="75" height="22" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{revenue}]]></expression>
				<box>
					<bottomPen lineWidth="0.5" lineColor="#C9CEC5"/>
				</box>
			</element>
			<element kind="textField" x="440" y="0" width="75" height="22" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{rating}]]></expression>
				<box rightPadding="8">
					<bottomPen lineWidth="0.5" lineColor="#C9CEC5"/>
				</box>
			</element>
		</band>
	</detail>
	<summary height="40">
		<element kind="textField" x="0" y="10" width="305" height="20" bold="true" vTextAlign="Middle">
			<expression><![CDATA[$R{report.total}]]></expression>
			<box leftPadding="8"/>
		</element>
		<element kind="textField" x="305" y="10" width="60" height="20" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$P{totalUnits}]]></expression>
		</element>
		<element kind="textField" x="365" y="10" width="75" height="20" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$P{totalRevenue}]]></expression>
		</element>
	</summary>
	<pageFooter height="24">
		<element kind="textField" x="0" y="6" width="515" height="16" style="Caption" hTextAlign="Center">
			<expression><![CDATA[$R{report.footer} + " · " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
