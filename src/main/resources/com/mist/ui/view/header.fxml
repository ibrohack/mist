<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>

<!-- Header: the navigation links of the user's role, included in the shell's top bar.
     See docs/ui-design.md, "Header". -->
<HBox alignment="CENTER_LEFT" styleClass="gap-[4px]"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mist.ui.controller.HeaderController">
  <fx:define>
    <ToggleGroup fx:id="links"/>
  </fx:define>
  <ToggleButton fx:id="storeLink" text="%nav.store" toggleGroup="$links" styleClass="mist-nav-link"
                onAction="#onLink"/>
  <ToggleButton fx:id="libraryLink" text="%nav.library" toggleGroup="$links" styleClass="mist-nav-link"
                onAction="#onLink"/>
  <ToggleButton fx:id="wishlistLink" text="%nav.wishlist" toggleGroup="$links" styleClass="mist-nav-link"
                onAction="#onLink"/>
  <ToggleButton fx:id="cartLink" text="%nav.cart" toggleGroup="$links" styleClass="mist-nav-link"
                contentDisplay="RIGHT" graphicTextGap="8" onAction="#onLink">
    <graphic>
      <Label fx:id="cartBadge" styleClass="mist-badge"/>
    </graphic>
  </ToggleButton>
  <ToggleButton fx:id="logLink" text="%nav.log" toggleGroup="$links" styleClass="mist-nav-link"
                onAction="#onLink"/>
</HBox>
