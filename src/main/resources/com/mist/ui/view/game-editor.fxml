<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<!-- Game editor: details, media, requirements, tags, languages and the editable achievements table.
     See docs/ui-design.md, "Game editor". -->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="mist-bg-void"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mist.ui.controller.GameEditorController">
  <VBox styleClass="p-8,gap-[18px]">
    <HBox alignment="CENTER_LEFT" styleClass="gap-[12px]">
      <Button fx:id="backButton" text="%game.back" styleClass="mist-button-secondary" onAction="#onBack"/>
      <Label fx:id="titleLabel" styleClass="mist-title"/>
      <Label fx:id="statusLabel" styleClass="mist-chip"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Button fx:id="delistButton" text="%studio.delist" styleClass="mist-button-danger" onAction="#onDelist"/>
      <Button fx:id="publishButton" text="%studio.publish" styleClass="mist-button-secondary" onAction="#onPublish"/>
      <Button fx:id="saveButton" text="%profile.save" defaultButton="true" onAction="#onSave"/>
    </HBox>
    <Label fx:id="formMessage" wrapText="true"/>

    <!-- Details -->
    <VBox styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
      <Label text="%editor.details" styleClass="mist-subtitle"/>
      <GridPane hgap="14" vgap="10">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS"/>
          <ColumnConstraints prefWidth="160"/>
          <ColumnConstraints prefWidth="170"/>
          <ColumnConstraints prefWidth="150"/>
        </columnConstraints>
        <Label text="%studio.column.name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label text="%studio.column.price" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%studio.column.release" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Label text="PEGI" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <DatePicker fx:id="releasePicker" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <ComboBox fx:id="pegiBox" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
      </GridPane>
      <Label text="%editor.description"/>
      <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="5"/>
      <Label fx:id="descriptionCounter" styleClass="mist-caption"/>
    </VBox>

    <!-- Media -->
    <VBox styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
      <Label text="%editor.media" styleClass="mist-subtitle"/>
      <HBox styleClass="gap-[20px]">
        <VBox styleClass="gap-[8px]">
          <StackPane fx:id="coverFrame" prefWidth="150" prefHeight="200" styleClass="mist-cover-frame">
            <ImageView fx:id="coverView" fitWidth="150" fitHeight="200" preserveRatio="true"/>
          </StackPane>
          <Button fx:id="changeCoverButton" text="%editor.changeCover" styleClass="mist-button-secondary"
                  maxWidth="Infinity" onAction="#onChangeCover"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="gap-[8px]">
          <Label text="%editor.screenshots" styleClass="mist-caption"/>
          <TilePane fx:id="screenshotsPane" hgap="8" vgap="8" prefTileWidth="160" prefTileHeight="90"/>
          <Button fx:id="addScreenshotButton" text="%editor.addScreenshot" styleClass="mist-button-secondary"
                  onAction="#onAddScreenshot"/>
        </VBox>
      </HBox>
    </VBox>

    <!-- Requirements -->
    <VBox styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
      <Label text="%game.requirements" styleClass="mist-subtitle"/>
      <GridPane hgap="14" vgap="10">
        <columnConstraints>
          <ColumnConstraints minWidth="160"/>
          <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%game.req.os" GridPane.rowIndex="0"/>
        <TextField fx:id="osField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%game.req.processor" GridPane.rowIndex="1"/>
        <TextField fx:id="processorField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%game.req.memory" GridPane.rowIndex="2"/>
        <TextField fx:id="memoryField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%game.req.graphics" GridPane.rowIndex="3"/>
        <TextField fx:id="graphicsField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="%game.req.storage" GridPane.rowIndex="4"/>
        <TextField fx:id="storageField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
      </GridPane>
    </VBox>

    <!-- Tags and languages -->
    <HBox styleClass="gap-[18px]">
      <VBox HBox.hgrow="ALWAYS" styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
        <Label text="%editor.tags" styleClass="mist-subtitle"/>
        <FlowPane fx:id="tagsPane" hgap="6" vgap="6"/>
        <HBox styleClass="gap-[8px]">
          <TextField fx:id="tagField" promptText="%editor.tagPrompt" HBox.hgrow="ALWAYS"/>
          <Button fx:id="addTagButton" text="%editor.addTag" styleClass="mist-button-secondary" onAction="#onAddTag"/>
        </HBox>
      </VBox>
      <VBox HBox.hgrow="ALWAYS" styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
        <Label text="%game.languages" styleClass="mist-subtitle"/>
        <FlowPane fx:id="languagesPane" hgap="14" vgap="8"/>
      </VBox>
    </HBox>

    <!-- Achievements -->
    <VBox styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
      <HBox alignment="CENTER_LEFT" styleClass="gap-[10px]">
        <Label text="%game.achievements" styleClass="mist-subtitle"/>
        <Label text="%editor.achievementsHint" styleClass="mist-caption"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="removeAchievementButton" text="%editor.removeAchievement" styleClass="mist-button-secondary"
                onAction="#onRemoveAchievement"/>
        <Button fx:id="addAchievementButton" text="%editor.addAchievement" styleClass="mist-button-secondary"
                onAction="#onAddAchievement"/>
      </HBox>
      <TableView fx:id="achievementsTable" editable="true" prefHeight="240">
        <placeholder>
          <Label text="%game.noAchievements" styleClass="mist-caption"/>
        </placeholder>
        <columns>
          <TableColumn fx:id="achievementNameColumn" text="%studio.column.name" prefWidth="260"/>
          <TableColumn fx:id="achievementDescriptionColumn" text="%editor.description" prefWidth="560"/>
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
      </TableView>
    </VBox>
  </VBox>
</ScrollPane>
