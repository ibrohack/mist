<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!-- New game dialog: the name and price of a draft. See docs/ui-design.md, "Developer dashboard" (STUDIO-3). -->
<VBox prefWidth="420" styleClass="gap-[10px]"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mist.ui.controller.NewGameDialog">
  <Label text="%studio.newGame.hint" styleClass="mist-caption" wrapText="true"/>
  <Label text="%studio.column.name" labelFor="$nameField"/>
  <TextField fx:id="nameField"/>
  <Label text="%studio.column.price" labelFor="$priceField"/>
  <TextField fx:id="priceField" promptText="19,99"/>
  <Label fx:id="formMessage" wrapText="true"/>
</VBox>
