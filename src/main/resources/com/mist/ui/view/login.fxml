<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- Login: brand panel on the left, form on the right. See docs/ui-design.md, "Login". -->
<HBox prefWidth="1280" prefHeight="800" styleClass="mist-bg-void"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mist.ui.controller.LoginController">
  <fx:define>
    <ToggleGroup fx:id="languageGroup"/>
  </fx:define>

  <!-- Brand panel: the splash's rings, the mark and the tagline. -->
  <StackPane fx:id="brandPanel" HBox.hgrow="ALWAYS" minWidth="360" styleClass="mist-bg-void">
    <Group>
      <Circle styleClass="mist-ring" radius="300"/>
      <Circle styleClass="mist-ring" radius="210"/>
      <Circle styleClass="mist-fill-acid" radius="96"/>
    </Group>
    <VBox alignment="BOTTOM_LEFT" StackPane.alignment="BOTTOM_LEFT" styleClass="p-16,gap-[16px]">
      <HBox alignment="CENTER_LEFT" styleClass="gap-[16px]">
        <ImageView fitWidth="56" fitHeight="56" preserveRatio="true">
          <Image url="@../images/mist-icon-256.png"/>
        </ImageView>
        <Label text="%app.title" styleClass="mist-text-fog,mist-login-wordmark"/>
      </HBox>
      <Label fx:id="tagline" text="%splash.tagline" styleClass="mist-text-ash,text-base"/>
    </VBox>
  </StackPane>

  <!-- Form panel. -->
  <VBox fx:id="formPanel" alignment="CENTER" minWidth="420" prefWidth="460" maxWidth="520"
        styleClass="mist-bg-surface,px-16,gap-[16px]">
    <HBox alignment="CENTER_RIGHT" styleClass="gap-[4px]">
      <Button fx:id="helpButton" text="?" styleClass="mist-toggle,mist-help-button" onAction="#onHelp"/>
      <ToggleButton fx:id="esToggle" text="ES" toggleGroup="$languageGroup" styleClass="mist-toggle"
                    onAction="#onLanguage"/>
      <ToggleButton fx:id="enToggle" text="EN" toggleGroup="$languageGroup" styleClass="mist-toggle"
                    onAction="#onLanguage"/>
    </HBox>
    <VBox styleClass="gap-[4px]">
      <Label fx:id="loginTitle" text="%login.title" styleClass="mist-title"/>
      <Label text="%login.subtitle" styleClass="mist-caption"/>
    </VBox>
    <VBox styleClass="gap-[6px]">
      <Label text="%field.email" labelFor="$emailField"/>
      <TextField fx:id="emailField" promptText="%login.email.prompt"/>
    </VBox>
    <VBox styleClass="gap-[6px]">
      <Label text="%field.password" labelFor="$passwordField"/>
      <PasswordField fx:id="passwordField"/>
    </VBox>
    <Button fx:id="loginButton" text="%login.submit" defaultButton="true" maxWidth="Infinity" onAction="#onLogin"/>
    <Label fx:id="formMessage" wrapText="true"/>
    <HBox alignment="CENTER_LEFT" styleClass="gap-[4px]">
      <Label text="%login.noAccount" styleClass="mist-caption"/>
      <Hyperlink fx:id="registerLink" text="%login.register" onAction="#onRegister"/>
    </HBox>
    <Hyperlink fx:id="guestLink" text="%login.guest" onAction="#onGuest"/>
  </VBox>
</HBox>
