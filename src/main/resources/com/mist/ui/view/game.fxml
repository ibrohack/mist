<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Game page, following the navigation diagram's Game view. See docs/ui-design.md, "Game page". -->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="mist-bg-void"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mist.ui.controller.GameController">
  <VBox styleClass="p-8,gap-[20px]">
    <HBox alignment="CENTER_LEFT" styleClass="gap-[16px]">
      <Button fx:id="backButton" text="%game.back" styleClass="mist-button-secondary" onAction="#onBack"/>
      <Label fx:id="nameTitle" styleClass="mist-title"/>
    </HBox>

    <!-- Media and facts -->
    <HBox styleClass="gap-[24px]">
      <VBox HBox.hgrow="ALWAYS" styleClass="gap-[10px]">
        <StackPane styleClass="mist-media-frame" minHeight="360" prefHeight="360">
          <ImageView fx:id="mainImage" fitWidth="640" fitHeight="360" preserveRatio="true"/>
        </StackPane>
        <HBox fx:id="thumbnails" styleClass="gap-[8px]"/>
      </VBox>
      <VBox prefWidth="360" minWidth="300" styleClass="mist-bg-surface,mist-rounded,p-6,gap-[14px]">
        <Label fx:id="descriptionText" wrapText="true" minHeight="-Infinity"/>
        <GridPane fx:id="factsGrid" hgap="12" vgap="8">
          <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
          </columnConstraints>
          <Label text="%game.rating.label" styleClass="mist-caption" GridPane.rowIndex="0"/>
          <Label fx:id="ratingText" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label text="%game.released" styleClass="mist-caption" GridPane.rowIndex="1"/>
          <Label fx:id="releaseText" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label text="%game.studio" styleClass="mist-caption" GridPane.rowIndex="2"/>
          <Label fx:id="studioText" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <FlowPane fx:id="tagsPane" hgap="6" vgap="6"/>
      </VBox>
    </HBox>

    <!-- Buy box -->
    <HBox fx:id="buyBox" alignment="CENTER_LEFT" styleClass="mist-bg-surface,mist-rounded,p-6,gap-[16px]">
      <Label fx:id="buyTitle" styleClass="mist-subtitle" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      <Label fx:id="statusLabel" styleClass="mist-message-ok"/>
      <Label fx:id="priceLabel" styleClass="mist-price,mist-price-large"/>
      <Button fx:id="wishlistButton" text="%game.addToWishlist" styleClass="mist-button-secondary"
              onAction="#onAddToWishlist"/>
      <Button fx:id="addToCartButton" text="%game.addToCart" onAction="#onAddToCart"/>
      <Button fx:id="goToCartButton" text="%game.goToCart" onAction="#onGoToCart"/>
      <Label fx:id="ownedLabel" text="%game.owned" styleClass="mist-message-ok"/>
      <Label fx:id="notOnSaleLabel" text="%game.notOnSale" styleClass="mist-caption"/>
    </HBox>

    <!-- Requirements, languages and PEGI -->
    <HBox styleClass="gap-[24px]">
      <VBox HBox.hgrow="ALWAYS" styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
        <Label text="%game.requirements" styleClass="mist-subtitle"/>
        <GridPane fx:id="requirementsGrid" hgap="16" vgap="8">
          <columnConstraints>
            <ColumnConstraints minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
          </columnConstraints>
          <Label text="%game.req.os" styleClass="mist-caption" GridPane.rowIndex="0"/>
          <Label fx:id="osText" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label text="%game.req.processor" styleClass="mist-caption" GridPane.rowIndex="1"/>
          <Label fx:id="processorText" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label text="%game.req.memory" styleClass="mist-caption" GridPane.rowIndex="2"/>
          <Label fx:id="memoryText" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
          <Label text="%game.req.graphics" styleClass="mist-caption" GridPane.rowIndex="3"/>
          <Label fx:id="graphicsText" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
          <Label text="%game.req.storage" styleClass="mist-caption" GridPane.rowIndex="4"/>
          <Label fx:id="storageText" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
      </VBox>
      <VBox prefWidth="360" minWidth="300" styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
        <Label text="%game.languages" styleClass="mist-subtitle"/>
        <Label fx:id="languagesText" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="pegiBadge" styleClass="mist-pegi"/>
      </VBox>
    </HBox>

    <!-- Achievements -->
    <VBox styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
      <Label text="%game.achievements" styleClass="mist-subtitle"/>
      <ListView fx:id="achievementsList" prefHeight="170"/>
    </VBox>

    <!-- Reviews -->
    <VBox styleClass="mist-bg-surface,mist-rounded,p-6,gap-[10px]">
      <HBox alignment="CENTER_LEFT" styleClass="gap-[12px]">
        <Label text="%game.reviews" styleClass="mist-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="yourReviewLabel" styleClass="mist-stars"/>
        <Button fx:id="reviewButton" text="%game.writeReview" styleClass="mist-button-secondary"
                onAction="#onWriteReview"/>
      </HBox>
      <ListView fx:id="reviewsList" prefHeight="300"/>
      <Pagination fx:id="reviewsPages" maxPageIndicatorCount="7" prefHeight="44" minHeight="44"/>
    </VBox>
  </VBox>
</ScrollPane>
