<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Orders: one row per order with its games under it; returns and receipts. See docs/ui-design.md,
     "Orders and returns". -->
<VBox styleClass="mist-bg-void,p-8,gap-[16px]"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mist.ui.controller.OrdersController">
  <HBox alignment="CENTER_LEFT" styleClass="gap-[12px]">
    <Button fx:id="backButton" text="%game.back" styleClass="mist-button-secondary" onAction="#onBack"/>
    <Label text="%orders.title" styleClass="mist-title"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="receiptButton" text="%orders.receipt" styleClass="mist-button-secondary" onAction="#onReceipt"/>
    <Button fx:id="returnButton" text="%orders.return" onAction="#onReturn"/>
  </HBox>
  <Label text="%orders.hint" styleClass="mist-caption" wrapText="true"/>

  <TreeTableView fx:id="ordersTable" showRoot="false" VBox.vgrow="ALWAYS">
    <placeholder>
      <Label text="%orders.empty" styleClass="mist-caption"/>
    </placeholder>
    <columns>
      <TreeTableColumn fx:id="dateColumn" text="%orders.column.date" prefWidth="200"/>
      <TreeTableColumn fx:id="gameColumn" text="%orders.column.game" prefWidth="320"/>
      <TreeTableColumn fx:id="priceColumn" text="%orders.column.price" prefWidth="120"/>
      <TreeTableColumn fx:id="statusColumn" text="%orders.column.status" prefWidth="200"/>
      <TreeTableColumn fx:id="refundColumn" text="%orders.column.refund" prefWidth="160"/>
    </columns>
    <columnResizePolicy>
      <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
    </columnResizePolicy>
    <contextMenu>
      <ContextMenu fx:id="rowMenu">
        <items>
          <MenuItem fx:id="openItem" text="%orders.open" onAction="#onOpen"/>
          <MenuItem fx:id="returnItem" text="%orders.return" onAction="#onReturn"/>
          <MenuItem fx:id="receiptItem" text="%orders.receipt" onAction="#onReceipt"/>
        </items>
      </ContextMenu>
    </contextMenu>
  </TreeTableView>
</VBox>
