<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Help window: the topics on the left, the chosen topic on the right. See docs/ui-design.md, "Help". -->
<BorderPane prefWidth="760" prefHeight="520" styleClass="mist-bg-void"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mist.ui.controller.HelpController">
  <left>
    <ListView fx:id="topicList" prefWidth="230" styleClass="mist-help-topics"/>
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <VBox styleClass="p-8,gap-[14px]">
        <Label fx:id="topicTitle" styleClass="mist-title" wrapText="true"/>
        <VBox fx:id="topicBody" styleClass="gap-[10px]"/>
      </VBox>
    </ScrollPane>
  </center>
  <bottom>
    <HBox alignment="CENTER_RIGHT" styleClass="mist-bg-surface,px-6,py-3">
      <Button fx:id="closeButton" text="%help.close" cancelButton="true" onAction="#onClose"/>
    </HBox>
  </bottom>
</BorderPane>
